<button class="icon-btn" @onclick="OnClick" disabled="@Disabled" title="@Tooltip">
    <i class="@Icon"></i>
</button>

@code {
    [Parameter] public string Icon { get; set; } // e.g., "bi bi-search"
    [Parameter] public string Tooltip { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
