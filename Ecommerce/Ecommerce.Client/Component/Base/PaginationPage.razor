<div class="pagination-container">
    <button class="page-btn" @onclick="GoToPreviousPage" disabled="@IsFirstPage">Previous</button>

    @for (int i = 1; i <= TotalPages; i++)
    {
        <button class="page-btn @(CurrentPage == i ? "active" : "")" @onclick="() => GoToPage(i)">
            @i
        </button>
    }

    <button class="page-btn" @onclick="GoToNextPage" disabled="@IsLastPage">Next</button>
</div>

@code {
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private bool IsFirstPage => CurrentPage <= 1;
    private bool IsLastPage => CurrentPage >= TotalPages;

    private async Task GoToPreviousPage()
    {
        if (!IsFirstPage)
        {
            await OnPageChanged.InvokeAsync(CurrentPage - 1);
        }
    }

    private async Task GoToNextPage()
    {
        if (!IsLastPage)
        {
            await OnPageChanged.InvokeAsync(CurrentPage + 1);
        }
    }

    private async Task GoToPage(int pageNumber)
    {
        if (pageNumber != CurrentPage)
        {
            await OnPageChanged.InvokeAsync(pageNumber);
        }
    }
}
